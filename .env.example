# Copy this file to .env and fill in the values. Never commit .env.

# --- OpenAI: answers and embeddings ---
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-6-luna
OPENAI_REASONING_EFFORT=none
OPENAI_EMBED_MODEL=text-embedding-3-large

# --- Pinecone ---
PINECONE_API_KEY=
PINECONE_INDEX_NAME=
PINECONE_REGION=us-east-1

# --- Google Drive ingestion ---
GOOGLE_DRIVE_FOLDER_ID=
GOOGLE_SERVICE_ACCOUNT_JSON=backend/credentials/service-account.json

# --- App ---
RETRIEVAL_TOP_K=5
CORS_ALLOW_ORIGINS=https://ask.haseebsagheer.com
